{
  "name": "mindstream",
  "version": "1.0.0",
  "description": "分支式LLM对话应用程序",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:vite": "vite --port 5173 --strictPort true -c electron.vite.config.ts src/renderer",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:custom": "node restart-dev.js",
    "restart": "node restart-dev.js",
    "build": "node clean.js && electron-vite build && electron-builder",
    "build:dir": "node clean.js && electron-vite build && electron-builder --dir",
    "build:win": "node clean.js && electron-vite build && electron-builder --win",
    "build:mac": "node clean.js && electron-vite build && electron-builder --mac",
    "build:linux": "node clean.js && electron-vite build && electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest"
  },
  "build": {
    "appId": "com.mindstream.app",
    "productName": "MindStream",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@babel/core": "^7.0.0",
    "@reduxjs/toolkit": "^1.9.5",
    "antd": "^5.5.0",
    "copy-to-clipboard": "^3.3.3",
    "electron-store": "^8.1.0",
    "i18next": "^22.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^12.3.0",
    "react-is": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.11.0",
    "styled-components": "^5.3.10",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "^18.16.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/styled-components": "^5.1.26",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "cross-env": "^7.0.3",
    "electron": "^24.3.0",
    "electron-builder": "^23.6.0",
    "electron-vite": "^3.0.0",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4",
    "vite": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/mindstream.git"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "llm",
    "chat",
    "ai"
  ],
  "author": "Your Name",
  "license": "MIT",
  "private": true
}
